# =============================================================================
# MioAgent — .env.example
# Canonical superset of ALL env variables read by backend code.
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# =============================================================================
# Core
# =============================================================================
SESSION_SECRET=development-secret
PORT=
CORS_ORIGIN=
BASE_PATH=
NODE_OPTIONS=

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgres://localhost:5432/mioagent
# Required only by `pnpm test:db`. Use a dedicated Neon test branch/database
# (or the isolated CI Postgres service). It must never identify the production
# host/database/Neon endpoint or branch.
TEST_DATABASE_URL=

# =============================================================================
# LLM
# =============================================================================
# LLM_PROVIDER: 'openai' | 'openai-compatible'
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Used only when LLM_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Not used by production code (no Anthropic SDK support):
ANTHROPIC_API_KEY=
# Legacy / unused:
LLM_GATEWAY_URL=

# =============================================================================
# Chain & RPC
# =============================================================================
# CHAIN_ENV controls network mode:
#   sepolia          — Base Sepolia testnet (chain 84532), execution allowed
#   mainnet-readonly — Base Mainnet (chain 8453), execution BLOCKED (safe default)
#   mainnet          — Base Mainnet, execution allowed only if MAINNET_EXECUTION_ENABLED=true
# See docs/MAINNET_CHECKLIST.md for the full switching procedure.
CHAIN_ENV=mainnet-readonly

# Second gate — must be 'true' to allow on-chain sends on mainnet:
MAINNET_EXECUTION_ENABLED=false

# Mainnet RPC (read by status.ts as BASE_MAINNET_RPC_URL):
BASE_MAINNET_RPC_URL=https://mainnet.base.org
# Legacy alias kept for backwards-compatibility:
BASE_RPC_URL=https://mainnet.base.org

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional Alchemy integration:
ALCHEMY_API_KEY=
ALCHEMY_BASE_MAINNET_RPC_URL=

# Fallback RPC list (space-separated URLs):
PRICE_RPC_FALLBACK_URLS=

# =============================================================================
# Data Providers
# =============================================================================
# TOKEN_BALANCES_PROVIDER: 'none' | 'moralis' | 'alchemy'
TOKEN_BALANCES_PROVIDER=none
# PRICE_PROVIDER: 'none' | 'moralis' | 'coingecko'
PRICE_PROVIDER=none
# TOKEN_SECURITY_PROVIDER: 'none' | 'goplus'
# GoPlus works on mainnet without a key (rate-limited). Not supported on Sepolia.
TOKEN_SECURITY_PROVIDER=none
# APPROVAL_PROVIDER: 'none' | 'moralis'
APPROVAL_PROVIDER=none

MORALIS_API_KEY=
# GoPlus API key — optional, free tier available without key:
# Optional higher-limit GoPlus backend authentication. Public token security
# requests work without credentials. Never expose APP_SECRET to the frontend.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
# CoinGecko API key — optional, free tier available without key:
COINGECKO_API_KEY=

# =============================================================================
# Base MCP (hosted OAuth MCP client)
# =============================================================================
# Canonical hosted Base MCP server URL. OAuth tokens are stored encrypted
# server-side per user; never expose access/refresh tokens to the frontend.
BASE_MCP_SERVER_URL=https://mcp.base.org
# Enable optional Base MCP status/OAuth integration. The app still works for
# read-only scans when disabled.
BASE_MCP_ENABLED=false
# Optional status probe path and timeout.
BASE_MCP_STATUS_PATH=/health
BASE_MCP_TIMEOUT_MS=2500
# Fixed hosted read-only Morpho MCP transport timeout. The endpoint remains https://mcp.morpho.org/.
MORPHO_MCP_TIMEOUT_MS=8000
# Minimum USD liquidity and maximum displayed APY for screened Morpho vault reads.
MORPHO_MIN_TVL_USD=1000000
MORPHO_MAX_APY_PCT=100
# Optional comma-separated vault addresses promoted to verified/allowlisted status.
MORPHO_TRUSTED_VAULT_ADDRESSES=
# Morpho markets do not currently carry verification metadata in every payload;
# only explicitly trusted IDs or records marked verified are shown by Agent Stream.
MORPHO_TRUSTED_MARKET_IDS=
MORPHO_MIN_MARKET_SUPPLY_USD=1000000
MORPHO_MIN_MARKET_LIQUIDITY_USD=100000
PARTNER_RESULT_MAX_APY_PCT=100
PARTNER_RESULT_MIN_LIQUIDITY_USD=100000
# Refresh Base MCP access tokens this many milliseconds before expiry.
BASE_MCP_REFRESH_SKEW_MS=300000
# Optional comma/space-separated tool policy overrides. Built-in deny rules still
# win over read-only allowlist entries.
BASE_MCP_READ_ONLY_TOOLS_ALLOWLIST=
BASE_MCP_FORBIDDEN_TOOLS_DENYLIST=
# Public API origin used to build the OAuth callback URL in production.
# If empty, local/dev requests derive it from request headers.
PUBLIC_API_BASE_URL=
# Deprecated aliases kept for backwards compatibility. Prefer BASE_MCP_SERVER_URL.
MCP_SERVER_URL=
BASE_MCP_URL=

# =============================================================================
# x402 (HTTP 402 micropayments)
# =============================================================================
# X402_FACILITATOR_URL: URL of your x402 facilitator service.
# Without a complete facilitator/payTo/network config, x402 runs in simulated or
# missing mode and will not claim real settlement.
# Example: https://facilitator.example.com
X402_FACILITATOR_URL=
# Optional facilitator auth. If omitted, API still boots and x402 status shows
# facilitator_auth_required when the facilitator rejects anonymous /supported.
# Preferred for Coinbase/CDP facilitator: set CDP_API_KEY_ID + CDP_API_KEY_SECRET
# so the server generates short-lived Bearer JWTs per facilitator endpoint.
# X402_FACILITATOR_AUTH_TOKEN remains a manual Bearer-token override.
X402_FACILITATOR_AUTH_TOKEN=
X402_FACILITATOR_API_KEY=
CDP_API_KEY=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
X402_FACILITATOR_TIMEOUT_MS=2500
# x402 payment recipient. Public address; never put a private key here.
X402_PAYTO_ADDRESS=
# CAIP-2 network only. Supported: eip155:8453, eip155:84532.
X402_NETWORK=
# USDC atomic units. 1000 = 0.001 USDC.
X402_AMOUNT_ATOMIC_USDC=1000
# Public x402 Builder Code. Must match ^[a-z0-9_]{1,32}$.
BUILDER_CODE=

# Buyer/fuel mode. Read-only scans remain free; paid outgoing resources can be
# enabled later with LLM_PAYMENT_MODE=x402 and a CDP-managed payer signer.
LLM_PAYMENT_MODE=free
# Optional deterministic outgoing paid-resource smoke URL. Used only by
# POST /api/x402/buyer-smoke when a user has an active fuel permission.
X402_BUYER_SMOKE_URL=
X402_BUYER_SMOKE_AMOUNT_USDC=0.001
# Optional CDP EVM server account name for outgoing x402 buyer payments.
# Defaults to BASE_SUBSCRIPTION_WALLET_NAME, CDP_SUBSCRIPTION_WALLET_NAME, or miorail-x402-buyer-payer.
X402_BUYER_PAYER_ACCOUNT_NAME=

# =============================================================================
# Autonomy — spend permissions
# =============================================================================
# Bounded action policies and reservations are persisted in Postgres tables
# `autonomy_policies` and `autonomy_execution_reservations`.
# CHAIN_ENV selects Base Sepolia vs Base Mainnet metadata; server-side mainnet
# execution remains fail-closed unless BOTH gates are enabled:
#   1. MAINNET_EXECUTION_ENABLED=true
#   2. per-user mainnet autonomy opt-in in server-side settings/storage
# `mainnet-readonly` always blocks autonomous mainnet execution.
# Set to 'true' to expose read/proof-recording routes for the legacy Base
# Sepolia controller. Mutations must still be signed by a connected wallet;
# the API never reads a private key or broadcasts.
ENABLE_TESTNET_AUTONOMY=false

# Address of MioSpendPermissionController deployed on Base Sepolia (chain 84532).
# Run: forge script contracts/script/Deploy.s.sol --rpc-url $BASE_SEPOLIA_RPC_URL --broadcast
# Then paste the logged address here.
BASE_SEPOLIA_SPEND_PERMISSION_CONTROLLER_ADDRESS=
# Alternative env name (same contract):
BASE_SEPOLIA_CONTROLLER_ADDRESS=

# Canonical USDC address on Base Sepolia (code default: 0x036CbD53842c5426634e7929541eC2318f3dCF7e):
BASE_SEPOLIA_USDC_ADDRESS=

# Canonical USDC address on Base Mainnet — native USDC (Circle, 6 decimals),
# NOT the bridged USDbC. Used by the action-plan builder + static simulation
# for the user-confirmed flow (T19). Code default: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_MAINNET_USDC_ADDRESS=

# T19.1: maximum USDC a `limited_transfer` user-confirmed action may move.
# Transfers above this cap fail closed to a read-only recommendation. Revoke-
# approval actions are uncapped (no funds move). Default: 100.
MAX_LIMITED_TRANSFER_USDC=100

# Base Account subscription charges for buyer fuel. These are server-side only;
# the app never stores user private keys. Set CDP_WALLET_SECRET in deployment
# secrets when automatic fuel charging is enabled.
CDP_WALLET_SECRET=
BASE_SUBSCRIPTION_WALLET_NAME=
CDP_SUBSCRIPTION_WALLET_NAME=
PAYMASTER_URL=

# =============================================================================
# Rate limits & Provider cache (T11.6 / T11.7)
# =============================================================================
PROVIDER_CACHE_ENABLED=true
PROVIDER_BALANCES_TTL_SECONDS=1800
PROVIDER_PRICES_TTL_SECONDS=900
PROVIDER_SECURITY_TTL_SECONDS=21600
PROVIDER_APPROVALS_TTL_SECONDS=1800
PROVIDER_MAX_CALLS_PER_MINUTE=20
PROVIDER_MAX_CALLS_PER_HOUR=300
# Per-provider hourly budgets (set to 0 to disable a provider via budget):
MORALIS_MAX_CALLS_PER_HOUR=300
GOPLUS_MAX_CALLS_PER_HOUR=300
COINGECKO_MAX_CALLS_PER_HOUR=300
ALCHEMY_MAX_CALLS_PER_HOUR=300

# =============================================================================
# Frontend variables (Vite build-time — set in artifacts/interface/.env)
# These VITE_* vars are NOT read by the backend. They must be present at
# 'vite build' time to be embedded in the frontend bundle.
# =============================================================================
# VITE_CHAIN_ENV: controls UI network display and chain expectations.
#   Must match backend CHAIN_ENV to avoid frontend/backend desync.
#   Values: 'sepolia' | 'mainnet-readonly' | 'mainnet'
# VITE_CHAIN_ENV=mainnet-readonly

# Operator-only vendor and transport diagnostics. Keep false in user builds.
# VITE_ENABLE_DIAGNOSTICS=false

# VITE_MCP_SERVER_URL is legacy only. Live Base MCP state comes from /api/status.
# VITE_MCP_SERVER_URL=

# VITE_API_PROXY_TARGET: Vite dev-server proxy target (default: http://localhost:8080).
# VITE_API_PROXY_TARGET=http://localhost:8080

# T19: Builder Code (ERC-8021) attribution. PUBLIC value from base.dev — NOT a
# secret. Attached to every wallet_sendCalls batch as a dataSuffix capability so
# Base can attribute onchain activity to this app. Empty → unattributed (one-time
# console warning). Register at https://base.dev > Settings > Builder Codes.
# VITE_BUILDER_CODE=

# =============================================================================
# Miniapp (Next.js — set in artifacts/miniapp/.env)
# =============================================================================
# NEXT_PUBLIC_URL=
# NEXT_PUBLIC_PROJECT_NAME=MioAgent
# NEXT_PUBLIC_ONCHAINKIT_API_KEY=
# MIOAGENT_API_URL=http://localhost:8080

# T19: Builder Code for the miniapp (same public value as VITE_BUILDER_CODE).
# NEXT_PUBLIC_BUILDER_CODE=
# Dedicated read-only Uniswap quote provider. Keep the key server-side.
# Only consulted when BASE_MCP_PLUGIN_MODE=direct.
UNISWAP_API_KEY=
UNISWAP_QUOTE_TIMEOUT_MS=8000

# T48b: constrained Base MCP skill runtime (plugin_http_request gateway).
#   BASE_MCP_PLUGIN_MODE: 'mcp' (default) | 'direct'
#     mcp    — Uniswap auth material comes from UNISWAP_MCP_GATEWAY_KEY below;
#              UNISWAP_API_KEY is NOT required and is NOT a release-gate.
#     direct — typed providers fall back to UNISWAP_API_KEY.
BASE_MCP_PLUGIN_MODE=mcp
# Server-only credential for the plugin_http_request gateway in mcp mode.
# Never sent to the LLM, never logged, never echoed in a tool trace/response.
UNISWAP_MCP_GATEWAY_KEY=
