# =============================================================================
# MioAgent — .env.example
# Canonical superset of ALL env variables read by backend code.
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# =============================================================================
# Core
# =============================================================================
SESSION_SECRET=development-secret
PORT=
CORS_ORIGIN=
BASE_PATH=
NODE_OPTIONS=

# T49 architecture-migration flags. Missing or invalid values preserve the
# legacy terminal and never enable route or paid intelligence functionality.
# These are server-side values; the frontend receives only booleans via
# /api/status.productMigration.
MIORAIL_ROUTE_INTELLIGENCE_V1=false
MIORAIL_LEGACY_TERMINAL=true
MIORAIL_PAID_INTELLIGENCE=false

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgres://localhost:5432/mioagent
# Required only by `pnpm test:db`. Use a dedicated Neon test branch/database
# (or the isolated CI Postgres service). It must never identify the production
# host/database/Neon endpoint or branch.
TEST_DATABASE_URL=

# =============================================================================
# LLM
# =============================================================================
# LLM_PROVIDER: 'openai' | 'openai-compatible'
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Used only when LLM_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Not used by production code (no Anthropic SDK support):
ANTHROPIC_API_KEY=
# Legacy / unused:
LLM_GATEWAY_URL=

# =============================================================================
# Chain & RPC
# =============================================================================
# CHAIN_ENV controls network mode:
#   sepolia          — Base Sepolia testnet (chain 84532), execution allowed
#   mainnet-readonly — Base Mainnet (chain 8453), execution BLOCKED (safe default)
#   mainnet          — Base Mainnet, execution allowed only if MAINNET_EXECUTION_ENABLED=true
# See docs/MAINNET_CHECKLIST.md for the full switching procedure.
CHAIN_ENV=mainnet-readonly

# Second gate — must be 'true' to allow on-chain sends on mainnet:
MAINNET_EXECUTION_ENABLED=false

# Mainnet RPC (read by status.ts as BASE_MAINNET_RPC_URL):
BASE_MAINNET_RPC_URL=https://mainnet.base.org
# Legacy alias kept for backwards-compatibility:
BASE_RPC_URL=https://mainnet.base.org

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# T69 B20 launch discovery (`pnpm b20:discover`).
# The FIRST block the launch feed should read. There is deliberately no
# default: a worker that guessed "somewhere recent" would silently define away
# every launch before its guess, and nothing downstream could tell that from a
# chain with no launches on it. A cold start without this stops with
# configuration_required (exit code 4) rather than reading anything.
B20_DISCOVER_START_BLOCK=

# Optional Alchemy integration:
ALCHEMY_API_KEY=
ALCHEMY_BASE_MAINNET_RPC_URL=

# Fallback RPC list (space-separated URLs):
PRICE_RPC_FALLBACK_URLS=

# =============================================================================
# Data Providers
# =============================================================================
# TOKEN_BALANCES_PROVIDER: 'none' | 'moralis' | 'alchemy'
TOKEN_BALANCES_PROVIDER=none
# PRICE_PROVIDER: 'none' | 'moralis' | 'coingecko'
PRICE_PROVIDER=none
# TOKEN_SECURITY_PROVIDER: 'none' | 'goplus'
# GoPlus works on mainnet without a key (rate-limited). Not supported on Sepolia.
TOKEN_SECURITY_PROVIDER=none
# APPROVAL_PROVIDER: 'none' | 'moralis'
APPROVAL_PROVIDER=none

MORALIS_API_KEY=
# GoPlus API key — optional, free tier available without key:
# Optional higher-limit GoPlus backend authentication. Public token security
# requests work without credentials. Never expose APP_SECRET to the frontend.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
# CoinGecko API key — optional, free tier available without key:
COINGECKO_API_KEY=

# =============================================================================
# Base MCP (hosted OAuth MCP client)
# =============================================================================
# Canonical hosted Base MCP server URL. OAuth tokens are stored encrypted
# server-side per user; never expose access/refresh tokens to the frontend.
BASE_MCP_SERVER_URL=https://mcp.base.org
# Enable optional Base MCP status/OAuth integration. The app still works for
# read-only scans when disabled.
BASE_MCP_ENABLED=false
# Optional status probe path and timeout.
BASE_MCP_STATUS_PATH=/health
BASE_MCP_TIMEOUT_MS=2500
# Fixed hosted read-only Morpho MCP transport timeout. The endpoint remains https://mcp.morpho.org/.
MORPHO_MCP_TIMEOUT_MS=8000
# Minimum USD liquidity and maximum displayed APY for screened Morpho vault reads.
MORPHO_MIN_TVL_USD=1000000
MORPHO_MAX_APY_PCT=100
# Optional comma-separated vault addresses promoted to verified/allowlisted status.
MORPHO_TRUSTED_VAULT_ADDRESSES=
# Morpho markets do not currently carry verification metadata in every payload;
# only explicitly trusted IDs or records marked verified are shown by Agent Stream.
MORPHO_TRUSTED_MARKET_IDS=
MORPHO_MIN_MARKET_SUPPLY_USD=1000000
MORPHO_MIN_MARKET_LIQUIDITY_USD=100000
PARTNER_RESULT_MAX_APY_PCT=100
PARTNER_RESULT_MIN_LIQUIDITY_USD=100000
# Refresh Base MCP access tokens this many milliseconds before expiry.
BASE_MCP_REFRESH_SKEW_MS=300000
# Optional comma/space-separated tool policy overrides. Built-in deny rules still
# win over read-only allowlist entries.
BASE_MCP_READ_ONLY_TOOLS_ALLOWLIST=
BASE_MCP_FORBIDDEN_TOOLS_DENYLIST=
# Public API origin used to build the OAuth callback URL in production.
# If empty, local/dev requests derive it from request headers.
PUBLIC_API_BASE_URL=
# Deprecated aliases kept for backwards compatibility. Prefer BASE_MCP_SERVER_URL.
MCP_SERVER_URL=
BASE_MCP_URL=

# =============================================================================
# x402 (HTTP 402 micropayments)
# =============================================================================
# X402_FACILITATOR_URL: URL of your x402 facilitator service.
# Without a complete facilitator/payTo/network config, x402 runs in simulated or
# missing mode and will not claim real settlement.
# Example: https://facilitator.example.com
X402_FACILITATOR_URL=
# Optional facilitator auth. If omitted, API still boots and x402 status shows
# facilitator_auth_required when the facilitator rejects anonymous /supported.
# Preferred for Coinbase/CDP facilitator: set CDP_API_KEY_ID + CDP_API_KEY_SECRET
# so the server generates short-lived Bearer JWTs per facilitator endpoint.
# X402_FACILITATOR_AUTH_TOKEN remains a manual Bearer-token override.
X402_FACILITATOR_AUTH_TOKEN=
X402_FACILITATOR_API_KEY=
CDP_API_KEY=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
X402_FACILITATOR_TIMEOUT_MS=2500
# x402 payment recipient. Public address; never put a private key here.
X402_PAYTO_ADDRESS=
# CAIP-2 network only. Supported: eip155:8453, eip155:84532.
X402_NETWORK=
# USDC atomic units. 1000 = 0.001 USDC.
X402_AMOUNT_ATOMIC_USDC=1000
# T67X-B1: the Builder Code, canonical name. PUBLIC value from base.dev — NOT a
# secret. One value serves both x402 payment attribution and the ERC-8021
# dataSuffix on wallet_sendCalls. Must match ^[a-z0-9_]{1,32}$; base.dev issues
# codes shaped like bc_a1b2c3d4.
#
# Required for MAINNET EXECUTION: with CHAIN_ENV=mainnet and
# MAINNET_EXECUTION_ENABLED=true, a missing or unusable code blocks execution
# readiness and fails `pnpm env:doctor`. Read-only capabilities are unaffected.
BASE_BUILDER_CODE=
# DEPRECATED alias, honoured for one iteration so a running deployment does not
# lose attribution on pull. Setting BOTH to DIFFERENT values fails closed:
# nothing is attributed at all. Delete this line once BASE_BUILDER_CODE is set.
# BUILDER_CODE=

# Buyer/fuel mode. Read-only scans remain free; paid outgoing resources can be
# enabled later with LLM_PAYMENT_MODE=x402 and a CDP-managed payer signer.
LLM_PAYMENT_MODE=free
# Optional deterministic outgoing paid-resource smoke URL. Used only by
# POST /api/x402/buyer-smoke when a user has an active fuel permission.
X402_BUYER_SMOKE_URL=
X402_BUYER_SMOKE_AMOUNT_USDC=0.001
# Optional CDP EVM server account name for outgoing x402 buyer payments.
# Defaults to BASE_SUBSCRIPTION_WALLET_NAME, CDP_SUBSCRIPTION_WALLET_NAME, or miorail-x402-buyer-payer.
X402_BUYER_PAYER_ACCOUNT_NAME=

# =============================================================================
# Paid transaction simulation (T59 — POST /api/route-intelligence/blueprints/:blueprintId/simulate)
# =============================================================================
# Gated behind MIORAIL_ROUTE_INTELLIGENCE_V1=true AND MIORAIL_PAID_INTELLIGENCE=true
# (see "Product migration flags" above). Without a valid price AND an
# allowlisted provider URL, the route fails closed with 503
# simulation_provider_unavailable — it never falls back to a default/free
# simulation and never silently skips payment.
#
# Decimal USDC price for one paid simulation (e.g. "0.01" = $0.01). Invalid
# values (non-positive, more than 6 fraction digits) also fail closed.
MIORAIL_SIMULATION_PRICE_USDC=0.01
# HTTPS URL of the env-configured transaction-simulation provider. The
# provider only ever receives {chainId: 8453, from, calls, blockTag:
# 'latest'} — no chat history, email, tenantId, or secrets.
MIORAIL_SIMULATION_PROVIDER_URL=
# Comma-separated hostnames MIORAIL_SIMULATION_PROVIDER_URL's host must
# appear in. Empty/missing = provider not configured (fail closed), even if
# a URL is set — this is a strict allowlist, never a fallback.
# Example: sim.example.com,fallback-sim.example.com
MIORAIL_SIMULATION_PROVIDER_ALLOWLIST=
#
# T63B — which simulation adapter serves BOTH paid flows (the T59 one-time x402
# route and the T60 Intelligence Budget route). The set is CLOSED; an id that is
# not listed here fails closed with 503 before any x402 challenge is issued:
#
#   generic-sim-v1           the T59 HTTP provider above (URL + allowlist)
#   alchemy-eth-simulate-v1  Alchemy eth_simulateV1 on Base mainnet (below)
#
# There is NO fallback between them: a settled payment must never buy a
# different service than the one it was quoted for.
MIORAIL_SIMULATION_PROVIDER_ID=generic-sim-v1

# =============================================================================
# Alchemy Base simulation adapter (T63B)
# =============================================================================
# Used only when MIORAIL_SIMULATION_PROVIDER_ID=alchemy-eth-simulate-v1.
# The endpoint is built SERVER-SIDE as
# https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_BASE_API_KEY} — there is no
# URL setting for it, the key is never sent to the client, never logged, and
# never part of a request/response hash. A missing key = provider_not_configured
# (fail closed), never a silent downgrade to another provider.
# Base mainnet (8453) only.
ALCHEMY_BASE_API_KEY=
# Bounded per-simulation timeout. Past it the call is provider_timeout; if a
# payment already settled the route answers paid_service_failed, never a 500.
MIORAIL_ALCHEMY_SIMULATION_TIMEOUT_MS=12000

# =============================================================================
# Earn Route — Moonwell + Morpho (T62 surface, T63A live data)
# =============================================================================
# The earn surface needs BOTH MIORAIL_ROUTE_INTELLIGENCE_V1=true and this flag,
# AND a passing on-chain pinned-contract preflight; the flag alone never opens
# it. Execution stays gated separately.
MIORAIL_EARN_ROUTE_V1=false
#
# T63A — live earn data. The comparison reads the official Moonwell HTTP API and
# the official Morpho GraphQL API (both read-only, both host-allowlisted) plus a
# direct Base read for the Moonwell market's atomic liquidity and block.
#
# Kill switch. true (default) = live provider data. false = the deterministic
# offline curated table; use only to ride out a provider outage, never as the
# steady state — the curated numbers are NOT market data.
MIORAIL_EARN_LIVE_DATA=true
# On-chain anchor for the Moonwell market (getCash/underlying + block number),
# read through BASE_MAINNET_RPC_URL. false = the reading still stands, but its
# liquidity and block are null and the liquidity dimension is Not scored.
MIORAIL_EARN_LIVE_CHAIN_READS=true
# How long a provider reading stays FRESH. Past it the reading is still shown,
# but it is excluded from every ranked dimension ("no data — no score").
EARN_LIVE_FRESHNESS_TTL_MS=300000
# Server-side observation cache (key: provider + pinned contract + chain).
# Concurrent comparisons share one upstream call; a cache hit is served with the
# provider's ORIGINAL observation time, so it can never look fresher than it is.
EARN_LIVE_CACHE_TTL_MS=30000
# How long a typed provider failure is remembered (stops hammering a broken
# provider; short enough that recovery is picked up promptly).
EARN_LIVE_CACHE_ERROR_TTL_MS=5000
# How long the last-known-good reading may still be SHOWN (as stale, never
# ranked) while a provider is failing. 0 disables it entirely.
EARN_LIVE_STALE_SERVE_MS=900000
# Bounded per-request timeout for both provider APIs.
EARN_LIVE_REQUEST_TIMEOUT_MS=6000

# =============================================================================
# Autonomy — spend permissions
# =============================================================================
# Bounded action policies and reservations are persisted in Postgres tables
# `autonomy_policies` and `autonomy_execution_reservations`.
# CHAIN_ENV selects Base Sepolia vs Base Mainnet metadata; server-side mainnet
# execution remains fail-closed unless BOTH gates are enabled:
#   1. MAINNET_EXECUTION_ENABLED=true
#   2. per-user mainnet autonomy opt-in in server-side settings/storage
# `mainnet-readonly` always blocks autonomous mainnet execution.
# Set to 'true' to expose read/proof-recording routes for the legacy Base
# Sepolia controller. Mutations must still be signed by a connected wallet;
# the API never reads a private key or broadcasts.
ENABLE_TESTNET_AUTONOMY=false

# Address of MioSpendPermissionController deployed on Base Sepolia (chain 84532).
# Run: forge script contracts/script/Deploy.s.sol --rpc-url $BASE_SEPOLIA_RPC_URL --broadcast
# Then paste the logged address here.
BASE_SEPOLIA_SPEND_PERMISSION_CONTROLLER_ADDRESS=
# Alternative env name (same contract):
BASE_SEPOLIA_CONTROLLER_ADDRESS=

# Canonical USDC address on Base Sepolia (code default: 0x036CbD53842c5426634e7929541eC2318f3dCF7e):
BASE_SEPOLIA_USDC_ADDRESS=

# Canonical USDC address on Base Mainnet — native USDC (Circle, 6 decimals),
# NOT the bridged USDbC. Used by the action-plan builder + static simulation
# for the user-confirmed flow (T19). Code default: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_MAINNET_USDC_ADDRESS=

# T19.1: maximum USDC a `limited_transfer` user-confirmed action may move.
# Transfers above this cap fail closed to a read-only recommendation. Revoke-
# approval actions are uncapped (no funds move). Default: 100.
MAX_LIMITED_TRANSFER_USDC=100

# Base Account subscription charges for buyer fuel. These are server-side only;
# the app never stores user private keys. Set CDP_WALLET_SECRET in deployment
# secrets when automatic fuel charging is enabled.
CDP_WALLET_SECRET=
BASE_SUBSCRIPTION_WALLET_NAME=
CDP_SUBSCRIPTION_WALLET_NAME=
PAYMASTER_URL=

# =============================================================================
# Rate limits & Provider cache (T11.6 / T11.7)
# =============================================================================
PROVIDER_CACHE_ENABLED=true
PROVIDER_BALANCES_TTL_SECONDS=1800
PROVIDER_PRICES_TTL_SECONDS=900
PROVIDER_SECURITY_TTL_SECONDS=21600
PROVIDER_APPROVALS_TTL_SECONDS=1800
PROVIDER_MAX_CALLS_PER_MINUTE=20
PROVIDER_MAX_CALLS_PER_HOUR=300
# Per-provider hourly budgets (set to 0 to disable a provider via budget):
MORALIS_MAX_CALLS_PER_HOUR=300
GOPLUS_MAX_CALLS_PER_HOUR=300
COINGECKO_MAX_CALLS_PER_HOUR=300
ALCHEMY_MAX_CALLS_PER_HOUR=300

# =============================================================================
# Frontend variables (Vite build-time — set in artifacts/interface/.env)
# These VITE_* vars are NOT read by the backend. They must be present at
# 'vite build' time to be embedded in the frontend bundle.
# =============================================================================
# VITE_CHAIN_ENV: controls UI network display and chain expectations.
#   Must match backend CHAIN_ENV to avoid frontend/backend desync.
#   Values: 'sepolia' | 'mainnet-readonly' | 'mainnet'
# VITE_CHAIN_ENV=mainnet-readonly

# Operator-only vendor and transport diagnostics. Keep false in user builds.
# VITE_ENABLE_DIAGNOSTICS=false

# VITE_MCP_SERVER_URL is legacy only. Live Base MCP state comes from /api/status.
# VITE_MCP_SERVER_URL=

# VITE_API_PROXY_TARGET: Vite dev-server proxy target (default: http://localhost:8080).
# VITE_API_PROXY_TARGET=http://localhost:8080

# T19/T67X-B1: Builder Code (ERC-8021) attribution for the web console. Same
# public value as BASE_BUILDER_CODE. Attached to every wallet_sendCalls batch as
# an OPTIONAL dataSuffix capability, so a wallet without dataSuffix support
# still sends the batch — unattributed. Empty → unattributed (one-time console
# warning). Register at https://base.dev > Settings > Builder Codes.
# VITE_BASE_BUILDER_CODE=
# DEPRECATED alias; conflicting values fail closed.
# VITE_BUILDER_CODE=

# =============================================================================
# Miniapp (Next.js — set in artifacts/miniapp/.env)
# =============================================================================
# NEXT_PUBLIC_URL=
# NEXT_PUBLIC_PROJECT_NAME=MioAgent
# NEXT_PUBLIC_ONCHAINKIT_API_KEY=
# MIOAGENT_API_URL=http://localhost:8080

# T19/T67X-B1: Builder Code for the miniapp (same public value as
# BASE_BUILDER_CODE).
# NEXT_PUBLIC_BASE_BUILDER_CODE=
# DEPRECATED alias; conflicting values fail closed.
# NEXT_PUBLIC_BUILDER_CODE=
# Dedicated read-only Uniswap quote provider. Keep the key server-side.
# Only consulted when BASE_MCP_PLUGIN_MODE=direct.
UNISWAP_API_KEY=
UNISWAP_QUOTE_TIMEOUT_MS=8000

# T48b: constrained Base MCP skill runtime (plugin_http_request gateway).
#   BASE_MCP_PLUGIN_MODE: 'mcp' (default) | 'direct'
#     mcp    — Uniswap auth material comes from UNISWAP_MCP_GATEWAY_KEY below;
#              UNISWAP_API_KEY is NOT required and is NOT a release-gate.
#     direct — typed providers fall back to UNISWAP_API_KEY.
BASE_MCP_PLUGIN_MODE=mcp
# Server-only credential for the plugin_http_request gateway in mcp mode.
# Never sent to the LLM, never logged, never echoed in a tool trace/response.
UNISWAP_MCP_GATEWAY_KEY=

# =============================================================================
# Commerce Route — Bitrefill (T64)
# =============================================================================
# TWO independent gates, because comparing a gift card is repeatable and buying
# one is not. Both need MIORAIL_ROUTE_INTELLIGENCE_V1=true as well.
#
# Comparison only: read the catalogue, score it, render the Commerce Route Card.
# Nothing can be ordered with this flag alone.
MIORAIL_COMMERCE_ROUTE_V1=false
# Checkout: opens a price-locked invoice at the storefront and returns the exact
# payment terms for review. It still SIGNS NOTHING and PAYS NOTHING — the wallet
# authorizes the x402 payment itself. Keep false until the promotion gate in
# docs/PLUGIN_REGISTRY.md is met.
MIORAIL_COMMERCE_EXECUTION_V1=false
#
# --- Credentials: TWO different Bitrefill APIs (T64.1) -----------------------
#
# These are NOT interchangeable, and the code refuses to cross them:
#
#   BITREFILL_API_KEY      -> Authorization: Bearer ...  -> Personal API /v2/*
#   BITREFILL_ACCESS_TOKEN -> X-Access-Token: ...        -> x402 SIWX   /x402/*
#
# Putting the Personal API key in BITREFILL_ACCESS_TOKEN ships an account
# credential to a gate that cannot use it. commerceAuthHeadersV1 throws on that
# pairing rather than sending it, so the misconfiguration is loud, not silent.
#
# Personal API key from https://www.bitrefill.com/account/developers.
# When set, this is the surface the server uses: an account-backed catalogue,
# invoices settled with payment_method=usdc_base, and no x402 micro-fees.
BITREFILL_API_KEY=
# Short-lived SIWX session token (~2h) for the x402 surface, used ONLY when no
# API key is set. Without either credential every gated x402 route answers 402
# and the surface reports provider_payment_required — honest, but no catalogue.
# Both are held in memory and are never logged, hashed, or placed in evidence.
BITREFILL_ACCESS_TOKEN=
# Bounded per-request timeout for catalogue and checkout calls.
MIORAIL_COMMERCE_TIMEOUT_MS=8000
#
# T64.2: commerce checkouts are DURABLE (migration 0015 —
# commerce_candidates / commerce_evidence / commerce_route_cards /
# commerce_orders / commerce_order_events / commerce_proofs). The routes answer
# a stable 503 `commerce_storage_unavailable` until that migration is applied,
# so run `pnpm --filter @mioagent/db migrate` before enabling the gates.
# How long a catalogue price stays FRESH. Past it the price is still shown but
# scores nothing ("no data — no score").
MIORAIL_COMMERCE_FRESHNESS_TTL_MS=120000

# ---------------------------------------------------------------------------
# T67B.1 — Aerodrome execution
# ---------------------------------------------------------------------------
# Aerodrome COMPARISON has no gate: quoting it alongside Uniswap and KyberSwap
# reads the Router over the Base RPC this deployment already has, spends
# nothing, and signs nothing. It needs BASE_MAINNET_RPC_URL (or BASE_RPC_URL);
# without one the adapter reports `not_configured` rather than pretending to
# have asked.
#
# This flag governs EXECUTION: selecting an Aerodrome route, building its
# calldata and signing it. Off, an Aerodrome candidate that reaches
# /swap/prepare gets the ordinary `unsupported_provider` outcome.
#
# Aerodrome calldata is written by this server rather than fetched from a
# partner, so a fork simulation is a PRECONDITION for it, not a nicety:
# without a working simulation provider (MIORAIL_SIMULATION_PROVIDER_ID +
# its key, above) every Aerodrome preparation is BLOCKED. Turning this on
# without one enables nothing.
MIORAIL_AERODROME_EXECUTION_V1=false

# ---------------------------------------------------------------------------
# T67C — B20 Control Card
# ---------------------------------------------------------------------------
# A read-only card: it inspects one B20 token at one block and reports what its
# controls permit. It prepares no transaction, requests no approval and never
# touches a wallet. The flag exists so the card stays off until a live smoke
# run has confirmed the interface against mainnet.
#
# Needs no new API key. It reads over BASE_MAINNET_RPC_URL (or BASE_RPC_URL),
# the same endpoint every other on-chain read uses; without one the routes
# answer 503 rather than guessing.
#
# That endpoint should be a KEYED one. One card costs about 17 eth_calls at a
# single pinned block, which the public https://mainnet.base.org throttles: the
# reader retries and paces itself, then reports the rows it could not read as
# `unavailable` and the snapshot as `partial`. Nothing is invented and no gap is
# shown as a value — the card is simply thinner than it should be.
#
# Requires migration 0021 (b20_control_snapshots / b20_control_evidence). The
# routes answer a stable 503 until it is applied, so run
# `pnpm --filter @mioagent/db migrate` before enabling the gate.
MIORAIL_B20_CONTROL_V1=false
# How long a stored snapshot answers a repeat inspection without re-reading the
# chain. The response is marked `cached: true` — a snapshot from four blocks
# ago is a different claim from a current one, and the user is told which.
MIORAIL_B20_CONTROL_TTL_MS=30000
# A Base mainnet B20 token, for `pnpm smoke:b20-control`. Operator-supplied:
# Base publishes no example mainnet token address, so nothing is hardcoded.
# See docs/B20_INTERFACE_RESEARCH.md §8 for addresses observed to satisfy
# isB20 on mainnet during the research gate.
SMOKE_B20_TOKEN_ADDRESS=
# Optional control address for the same smoke run; defaults to canonical USDC.
# It must come back as `not_b20` — a detector that says yes to everything
# passes a B20-only test perfectly.
SMOKE_ERC20_ADDRESS=

# --- T67C.2 — submission recovery and public proof ---------------------------
# Submission recovery. A user who reloads after their wallet already broadcast
# an atomic batch can finish CHECKING that batch: Miorail reads the saved batch
# id, asks the wallet what happened and records the answer through the same
# submission path as always. It never re-sends, and there is no code path from
# recovery to wallet_sendCalls at all.
#
# Requires migration 0022 (submission_attempts). The routes answer a stable 503
# until it is applied. Off until a live recovery smoke has been run.
MIORAIL_SUBMISSION_RECOVERY_V1=false
# Public proof links. Kept separate from recovery on purpose: one finishes a
# transaction the user already made, the other publishes their wallet address
# and transaction hashes to anyone holding the link. Publishing is always an
# explicit action by the owner, never automatic, and always revocable.
#
# Requires migration 0022 (public_proof_shares).
MIORAIL_PUBLIC_PROOF_V1=false
# Checking a published proof needs no Miorail account and no running API:
#   pnpm proof:verify -- ./miorail-proof-<publicId>.json
# Exit 0 valid, 1 invalid or modified, 2 the file could not be read.
