{
  "name": "mioagent-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test:unit": "node --import tsx scripts/run-tests.ts unit",
    "test:db": "node --import tsx scripts/run-tests.ts db",
    "test": "pnpm test:unit && pnpm test:db",
    "validate:tasks": "node scripts/validate_tasks.js",
    "lint": "eslint . && markdownlint '**/*.md'",
    "format": "prettier --write .",
    "smoke:llm": "tsx scripts/smoke_runtime.ts",
    "smoke:api": "tsx scripts/smoke_api.ts",
    "smoke:sepolia-action": "tsx scripts/seed_sepolia_action.ts && pnpm smoke:api",
    "smoke:approvals": "tsx scripts/smoke_approvals.ts",
    "smoke:alchemy-sim": "tsx scripts/smoke_alchemy_simulation.ts",
    "db:probe": "tsx scripts/db_probe.ts",
    "env:doctor": "node scripts/env-doctor.mjs",
    "smoke:bitrefill": "tsx scripts/smoke_bitrefill_commerce.ts",
    "smoke:bitrefill-invoice": "tsx scripts/smoke_bitrefill_invoice.ts",
    "smoke:opensea-nft": "tsx scripts/smoke_opensea_nft.ts",
    "smoke:b20-control": "tsx scripts/smoke_b20_control.ts",
    "proof:verify": "tsx lib/proof-verifier/src/cli.ts",
    "outcomes:backfill": "tsx scripts/outcomes_backfill.ts",
    "reliability:rebuild": "tsx scripts/reliability_rebuild.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli": "^0.49.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.61.1"
  }
}
