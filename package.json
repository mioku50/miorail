{
  "name": "mioagent-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "node --test scripts/ && pnpm -r test",
    "validate:tasks": "node scripts/validate_tasks.js",
    "lint": "eslint . && markdownlint '**/*.md'",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli": "^0.49.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.61.1"
  }
}