# =============================================================================
# artifacts/interface — Vite frontend .env.example
# Copy to artifacts/interface/.env for local development.
# These VITE_* variables are embedded at BUILD TIME by Vite — they are NOT
# secrets, but .env is listed in .gitignore to prevent accidental commits.
# =============================================================================

# VITE_CHAIN_ENV: controls UI network mode and chain ID expectations.
#   Must match backend CHAIN_ENV to avoid frontend/backend desync.
#   Values: 'sepolia' | 'mainnet-readonly' | 'mainnet'
#   After changing, rebuild: pnpm --filter interface build
VITE_CHAIN_ENV=mainnet-readonly

# VITE_MCP_SERVER_URL is legacy only. Live Base MCP state comes from /api/status.
VITE_MCP_SERVER_URL=

# VITE_API_PROXY_TARGET: Vite dev-server proxy target for /api and /health routes.
# Default if unset: http://localhost:8080
VITE_API_PROXY_TARGET=http://localhost:8080
