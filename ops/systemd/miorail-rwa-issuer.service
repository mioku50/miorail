[Unit]
# Ask each issuer's own root about each candidate address. Phase 9B.1.
#
# Oneshot, driven by miorail-rwa-issuer.timer. `getDShares()` reverts on both live Dinari factories on Base although both published ABIs declare it, so there is no enumerable membership list: every row exists because the root was asked about that exact address. A `true` establishes the ISSUER and never
# the security. Read-only outside Miorail's own evidence tables: no signer, no key, no chain write, no wallet.
Description=Miorail issuer-membership verification
Documentation=https://github.com/mioku50/miorail
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent
EnvironmentFile=/home/miorail/mioagent/.env
Environment=NODE_ENV=production
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node --import tsx scripts/rwa_verify_issuer_membership.ts

TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-rwa-issuer
