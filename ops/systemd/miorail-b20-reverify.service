[Unit]
# Re-read every verified project claim whose evidence has aged out.
#
# Oneshot, driven by miorail-b20-reverify.timer. Not a long-running worker:
# the queue is the number of verified claims, which is small, and a pass that
# finds nothing due exits in milliseconds.
Description=Miorail B20 project-claim re-verification pass
Documentation=https://github.com/mioku50/mioagent
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent
EnvironmentFile=/home/miorail/mioagent/.env
Environment=NODE_ENV=production
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
# Read-only against Base and against every third party except the two project
# tables. No signer, no key, no chain write.
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node --import tsx scripts/b20_reverify_projects.ts --write --limit 50

TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-b20-reverify
