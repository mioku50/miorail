[Unit]
# Base App notifications, from what Miorail already records.
#
# Issuer events to every wallet that pinned Miorail in Base App and turned its
# notifications on; market transitions to the wallets that watch the token;
# Radar events to the watch's owner. At most one push per wallet per pass and a
# few per day. See scripts/baseAppNotify.ts.
#
# Oneshot, driven by miorail-base-app-notify.timer. Reads Miorail's own tables
# and Base's list of opted-in wallets; writes only its cursor and a daily count.
# No signer, no chain write, no wallet. BASE_DEV_API is read from the env file
# and never printed; without it the pass reports "off" and sends nothing.
Description=Miorail Base App notifications
Documentation=https://github.com/mioku50/miorail
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent
EnvironmentFile=/home/miorail/mioagent/.env
Environment=NODE_ENV=production
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node --import tsx scripts/base_app_notify.ts

TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-base-app-notify
