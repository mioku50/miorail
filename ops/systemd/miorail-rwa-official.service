[Unit]
# One check of every reviewed source of the OFFICIAL trust root. Membership moves only when a check completes: a source that times out is stored as exactly that and withdraws nothing.
#
# Oneshot, driven by miorail-rwa-official.timer. Read-only outside Miorail's own
# evidence tables: no signer, no key, no chain write, no wallet.
Description=Miorail official-asset source check
Documentation=https://github.com/mioku50/miorail
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent
EnvironmentFile=/home/miorail/mioagent/.env
Environment=NODE_ENV=production
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node --import tsx scripts/rwa_ingest_official.ts

TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-rwa-official
