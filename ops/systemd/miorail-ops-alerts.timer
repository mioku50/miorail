[Unit]
# Every two minutes. The fastest workers run every five, so a failure that a
# clean next run would clear is still seen, and an API that stopped answering
# is said within a few minutes. Every pass starts Node: about a second of one
# core.
Description=Check Miorail units for failures

[Timer]
OnCalendar=*:0/2
AccuracySec=15s

[Install]
WantedBy=timers.target
