[Unit]
# The watchlist's freshness promise, kept.
#
# One measurement per ADDRESS however many accounts watch it, at an interval
# derived from how many addresses there are rather than configured. A failed
# pass moves the clock so a broken address cannot monopolise the queue, and
# claims nothing: no freshness, no signal.
#
# Oneshot, driven by miorail-rwa-watchlist.timer. Read-only outside Miorail's
# own evidence tables: no signer, no key, no chain write, no wallet.
Description=Miorail watchlist freshness sweep
Documentation=https://github.com/mioku50/miorail
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent
EnvironmentFile=/home/miorail/mioagent/.env
Environment=NODE_ENV=production
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node --import tsx scripts/rwa_watchlist_sweep.ts

TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-rwa-watchlist
