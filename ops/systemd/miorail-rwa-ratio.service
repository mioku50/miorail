[Unit]
# Exact-address outstanding supply for every reviewed representation, plus the
# issuer-specific ratio between token units and underlying shares, read and
# stored. Base Docs: "One B20 token does not permanently equal one share."
#
# Oneshot, driven by miorail-rwa-ratio.timer. The tokens publish no advance notice this build can call — uiMultiplier/newUIMultiplier/effectiveAt all revert — so comparing today against the stored value is the ONLY way a corporate action is ever noticed. Read-only outside Miorail's own
# evidence tables: no signer, no key, no chain write, no wallet.
Description=Miorail representation supply and ratio evidence read
Documentation=https://github.com/mioku50/miorail
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent
EnvironmentFile=/home/miorail/mioagent/.env
# Keep evidence reads on the same operator-reviewed RPC as the API. This file
# is deliberately second: its BASE_MAINNET_RPC_URL overrides the repository
# fallback without copying provider credentials into git.
EnvironmentFile=/etc/miorail/api-rpc.env
Environment=NODE_ENV=production
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node --import tsx scripts/rwa_read_representation_ratio.ts

TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-rwa-ratio
