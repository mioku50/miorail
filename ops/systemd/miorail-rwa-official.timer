[Unit]
# Every hour: the issuer API may add a batch before the Base pages catch up.
#
# Read the API and both Base publications independently. An hourly check bounds
# discovery lag even when the documentation has not caught up with issuance.
# Stored hashes keep changes distinguishable from an unchanged response.
Description=Check the reviewed official-asset sources

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
