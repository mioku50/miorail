[Unit]
Description=Miorail Base App MiniApp
Documentation=https://github.com/mioku50/mioagent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent/artifacts/miniapp
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
# Port 3020, not 3010.
#
# 3010 is claimed by an unrelated application on this host — a PM2-managed
# Next 14 app in a restart loop, which re-binds the port every few seconds. On
# 2026-08-17 it took 3010 during the one second this unit was down for its
# deploy restart, and the whole deploy then failed on a health check for a
# surface no Nginx site routes to.
#
# A fixed port shared with a neighbour is a race the loser cannot win by
# retrying, so this moved rather than gained a retry. 3020 is Miorail's and is
# listened on by nothing else.
# Next is invoked directly rather than through `pnpm exec`.
#
# The server had carried an out-of-repo drop-in doing exactly this since before
# 2026-08-17 — which is how the port stayed 3010 no matter what this file said,
# because a drop-in's ExecStart wins over the unit's. The working invocation
# belongs in the commit, and the deploy now deletes that override directory so
# no server-only edit can decide how this service starts again.
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node /home/miorail/mioagent/artifacts/miniapp/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3020

KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent/artifacts/miniapp/.next
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-miniapp

[Install]
WantedBy=multi-user.target
