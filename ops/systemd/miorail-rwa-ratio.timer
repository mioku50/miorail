[Unit]
# Every six hours.
#
# Supply selects the current comparison denominator; issuer-specific ratios
# normalize the representations inside it. Six hours, plus the engine's one
# hour jitter allowance, bounds both facts without treating an RPC failure as
# zero supply or an absent ratio as one-to-one.
Description=Read reviewed representation supply and ratios

[Timer]
OnBootSec=9min
OnUnitActiveSec=6h
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
