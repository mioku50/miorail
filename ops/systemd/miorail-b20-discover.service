[Unit]
Description=Miorail B20 launch discovery worker
Documentation=https://github.com/mioku50/mioagent
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent
EnvironmentFile=/home/miorail/mioagent/.env
Environment=NODE_ENV=production
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node --import tsx scripts/b20_discover_worker.ts

KillSignal=SIGTERM
TimeoutStopSec=90
Restart=always
RestartSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-b20-discover

[Install]
WantedBy=multi-user.target
