[Unit]
# Still Agent's errands: the days that came, reminded once.
#
# Each due errand's day is claimed once in still_agent_errand_runs, the errand
# moves to its next day, and the reminder goes from the person's own bot, from
# Still's agents bot, or nowhere but the site. See scripts/stillAgentErrands.ts.
#
# Oneshot, driven by miorail-still-agent-errands.timer. Reads and writes Still
# Agent's own tables and sends Telegram messages. No signer, no chain write, no
# invoice. Off unless STILL_AGENT_V1=on; the bot tokens and the key that seals
# personal bots' tokens are read from the env file and never printed.
Description=Miorail Still Agent errands
Documentation=https://github.com/mioku50/miorail
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent
EnvironmentFile=/home/miorail/mioagent/.env
Environment=NODE_ENV=production
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node --import tsx scripts/still_agent_errands.ts

TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-still-agent-errands
