[Unit]
# The public cash-exit ladder for the whole REVIEWED universe — every representation with tokens outstanding, across all four issuers, not one issuer's registry. Four exact sizes, two destinations, quoted through the approved router set. Paces itself between assets; an asset it cannot read is skipped, never reported as an asset with no market.
#
# Oneshot, driven by miorail-rwa-cash-exit.timer. Read-only outside Miorail's own
# evidence tables: no signer, no key, no chain write, no wallet.
Description=Miorail official-asset cash-exit measurement
Documentation=https://github.com/mioku50/miorail
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent
EnvironmentFile=/home/miorail/mioagent/.env
Environment=NODE_ENV=production
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node --import tsx scripts/rwa_measure_cash_exit.ts

TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-rwa-cash-exit
