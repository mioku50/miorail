[Unit]
# The public cash-exit ladder for the whole REVIEWED universe — every representation with tokens outstanding, across all four issuers, not one issuer's registry. Four exact sizes, two destinations, quoted through the approved router set. Paces itself between assets; an asset it cannot read is skipped, never reported as an asset with no market.
#
# Oneshot, driven by miorail-rwa-cash-exit.timer. Read-only outside Miorail's own
# evidence tables: no signer, no key, no chain write, no wallet.
Description=Miorail official-asset cash-exit measurement
Documentation=https://github.com/mioku50/miorail
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=miorail
Group=miorail
WorkingDirectory=/home/miorail/mioagent
EnvironmentFile=/home/miorail/mioagent/.env
Environment=NODE_ENV=production
Environment=PATH=/home/miorail/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/miorail/.nvm/versions/node/v22.23.1/bin/node --import tsx scripts/rwa_measure_cash_exit.ts

# Measured on the first widened pass: about 27 seconds per representation —
# eight router quotes plus the 2.5s politeness gap — so 84 of them is roughly
# forty minutes. At the old 1800s the timer would have killed the pass
# two-thirds of the way through the corpus and left the tail carrying whatever
# it was carrying before, which reads on a card exactly like an asset nobody
# has measured.
#
# Since 2026-11-11 every quote of the pass waits its turn (at most one every
# 400 ms: KyberSwap's public limit is three a second) and a 429 is waited out
# once, so a pass over about 390 representations takes most of an hour. A pass
# that still ends mostly rate limited exits 75; miorail-ops-alerts then reports
# this unit as failed, and as recovered after the next pass that got through.
TimeoutStartSec=5400
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/miorail/mioagent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miorail-rwa-cash-exit
